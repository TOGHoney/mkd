# FastAPI AI & RAG Engine Environment Variables

# Service Port and Host
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
DEBUG=True

# Qdrant Vector Database
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=company_memories

# Embedding Model (BAAI/bge-small-en-v1.5, 384-d run locally via FastEmbed ONNX)
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384

# Groq LLM (Required for generative streaming RAG responses)
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Crawler Settings
DEFAULT_CRAWL_MAX_DEPTH=2
DEFAULT_CRAWL_MAX_PAGES=25
CRAWL_TIMEOUT_SECONDS=15.0
