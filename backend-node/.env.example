# Express Control Backend Environment Variables

PORT=5000
NODE_ENV=development

# MongoDB Connection String (Atlas URI or local mongod)
MONGODB_URI=mongodb://localhost:27017/supermemory

# Redis URL (BullMQ job queues, rate limiting, and cache)
# Note: In-memory fallback is automatically used if Redis is not running locally
REDIS_URL=redis://localhost:6379

# JWT Secret for Session & Access Tokens
JWT_SECRET=supermemory_jwt_secret_dev_key_2026

# Python FastAPI AI Microservice URL
FASTAPI_URL=http://localhost:8000
